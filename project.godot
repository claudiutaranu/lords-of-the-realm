; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Realm Prototype"
config/version="0.1.0"
run/main_scene="res://scene/main-menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/output_latency=60

[autoload]

Settings="*res://scripts/Settings.cs"
Music="*res://scripts/MusicPlayer.cs"
Narrator="*res://scripts/Narrator.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Realm Prototype"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

; Nothing was anti-aliased at all, which is Godot's default and was wrong for this map: a terrain
; full of high-contrast rock-against-grass edges crawls with jaggies without it. MSAA answers the
; silhouettes and TAA the shading, and the shading is most of it here — a rock/grass boundary is a
; texture edge inside a triangle, which MSAA cannot see.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/screen_space_aa=1

rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
